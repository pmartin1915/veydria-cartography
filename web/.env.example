# Base URL of the canonical worldbuilder compendium (Vite + React static build
# from worldbuilder/tools/map-viewer/). CompendiumPanel.tsx uses this to
# deep-link out for the lenses cartography doesn't carry (Sacred Registers,
# Pilgrimage Routes, Reform Movements, Crisis Dashboard, full-body search).
#
# Default is the worldbuilder map-viewer's local dev server. Override when the
# worldbuilder map-viewer is deployed (e.g. GitHub Pages).
#
# No trailing slash is required; the helper normalizes it.
VITE_WORLDBUILDER_COMPENDIUM_URL=http://localhost:5173
