{
  "name": "veydria-cartography-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:tauri": "tsc -b && vite build --mode tauri",
    "tauri": "tauri",
    "preview": "vite preview",
    "sync:data": "node ../scripts/sync-world-data.mjs",
    "build:asterisms": "node ../scripts/build-asterisms.mjs",
    "generate:calendar": "python ../generator/export/calendar_ts.py",
    "sim:journey": "vite-node ../scripts/sim/sim-journey.ts --",
    "sim:batch": "vite-node ../scripts/sim/sim-batch.ts --",
    "sim:policy-report": "vite-node ../scripts/sim/sim-policy-report.ts --",
    "sim:fun-report": "vite-node ../scripts/sim/sim-fun-report.ts --",
    "sim:passage": "vite-node ../scripts/sim/sim-passage-report.ts --",
    "sim:passage-play": "vite-node ../scripts/sim/passage-playthrough.ts --",
    "sim:regret-model": "vite-node ../scripts/sim/sim-regret-model.ts --",
    "sim:trail": "vite-node ../scripts/sim/sim-trail.ts --",
    "sim:trail-report": "vite-node ../scripts/sim/sim-trail-report.ts --",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "check:size": "node ../scripts/check-bundle-size.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "d3": "^7.9.0",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "marked": "^18.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^2.1.9",
    "happy-dom": "^20.9.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "yaml": "^2.6.0"
  }
}
